import "." as Components

Node {
    on_ready: {
        let count = $.this.children_count as u32;
        // count == 0 { return; }
        let mut y = 0.0;

        for i in 0 .. count {
            //$.this.childrens[i].anchors = "horizontal_center__top";
            $.this.childrens[i].top_margin = y;
            y += 60.;//$.this.childrens[i].computed_height;
        }

    }

    // todo
    // we could generate binding to re-evaluate property when a binding is detected in the value
    // like qml Qt.binding : $.this.children[i].top_margin = Rml.binding(fn() { return $.this.children[i].computed_y; })
}