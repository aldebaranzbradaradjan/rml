import "." as Components

Node {
    on_ready: {
        let count = $.this.children_count as u32;
        let mut y = 0.0;

        for i in 0 .. count {
            $.this.childrens[i].anchors = "horizontal_center__top".to_string();
            $.this.childrens[i].top_margin = y;
            y += 60.;
        }
    }
}